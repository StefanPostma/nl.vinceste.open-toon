{
  "name": "nl.vinceste.open-toon",
  "version": "2.0.0",
  "description": "Let Homey control your Toon®!",
  "main": "app.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^1.8.3",
    "@types/node": "~22",
    "eslint": "~8.57.1",
    "eslint-config-athom": "~4.0.2",
    "homey": "~4.6.3"
  },
  "scripts": {
    "lint": "eslint --ext .js,.cjs --max-warnings 0 --ignore-path .gitignore .",
    "test": "node --require ./test/helpers/register.cjs --test \"test/**/*.test.js\"",
    "test:coverage": "node --require ./test/helpers/register.cjs --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-lines=90 \"test/**/*.test.js\"",
    "validate": "node scripts/validate.js",
    "validate:verified": "node scripts/validate.js --level verified",
    "pack:check": "node scripts/check-pack.js",
    "check:requirements": "node scripts/check-requirements.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefanPostma/nl.vinceste.open-toon.git"
  },
  "author": "Vinceste IT",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/StefanPostma/nl.vinceste.open-toon/issues"
  },
  "homepage": "https://github.com/StefanPostma/nl.vinceste.open-toon#readme"
}
